@echo off
chcp 65001 >nul
title 从 GitHub 私人仓库拉取最新更新

echo ====================================================
echo           正在从 GitHub 拉取最新更新至本地
echo ====================================================
echo.

cd /d "%~dp0"

git pull origin main

if %errorlevel% equ 0 (
    echo.
    echo ====================================================
    echo               拉取成功！本地已是最新状态
    echo ====================================================
) else (
    echo.
    echo ====================================================
    echo         拉取失败，请检查网络或是否有未提交的冲突
    echo ====================================================
)

echo.
pause